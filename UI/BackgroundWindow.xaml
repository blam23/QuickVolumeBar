<Window x:Class="UI.BackgroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="QuickVolumeBar" Height="1" Width="1" ResizeMode="NoResize" WindowStyle="None" Opacity="0">
    <tb:TaskbarIcon x:Name="TrayIcon"
                    Visibility="Hidden"
                    ToolTipText="Quick Volume Bar"
                    IconSource="Icon.ico"
                    TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="StartupToggle" Header="Run on Startup" IsCheckable="True" Click="Startup_Click"/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
</Window>
