<Window x:Class="UI.DiscordDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UI"
        Title="Discord Audio Diagnostics"
        Width="1280" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="CopyableCell" TargetType="DataGridCell">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Copy cell"
                                  Command="{x:Static local:DiscordDiagnosticsWindow.CopyCellCommand}"
                                  CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReadableColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9E4ED" />
            <Setter Property="Foreground" Value="#17151B" />
            <Setter Property="BorderBrush" Value="#C8C0CF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid Background="#17151B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#25212B" Padding="14,10">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="Discord process and audio-session monitor"
                           Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,18,0" />
                <TextBlock x:Name="txtStatus" Text="Starting audio session scan..."
                           Foreground="#D7C9E3" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10" Background="#17151B" Foreground="White">
            <TabItem Header="Audio sessions">
                <DataGrid x:Name="dgSessions" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="#211D26" Foreground="White" RowBackground="#211D26"
                          AlternatingRowBackground="#2A2430" BorderThickness="0"
                          CellStyle="{StaticResource CopyableCell}"
                          ColumnHeaderStyle="{StaticResource ReadableColumnHeader}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65" />
                        <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="120" />
                        <DataGridTextColumn Header="Session name" Binding="{Binding SessionName}" Width="170" />
                        <DataGridTextColumn Header="Direction" Binding="{Binding DataFlow}" Width="82" />
                        <DataGridTextColumn Header="Endpoint #" Binding="{Binding EndpointNumber}" Width="82" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="78" />
                        <DataGridTextColumn Header="Volume" Binding="{Binding VolumeText}" Width="75" />
                        <DataGridTextColumn Header="Muted" Binding="{Binding IsMuted}" Width="60" />
                        <DataGridTemplateColumn Header="Live peak" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PeakText}" Width="44"
                                                   Foreground="White" TextAlignment="Right" Margin="6,0,0,0" />
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding PeakPercent, Mode=OneWay}"
                                                     Height="14" Foreground="#B76CE0" Background="#514A57" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Session ID" Binding="{Binding SessionIdentifier}" Width="260" />
                        <DataGridTextColumn Header="Session instance ID" Binding="{Binding SessionInstanceIdentifier}" Width="360" />
                        <DataGridTextColumn Header="Grouping GUID" Binding="{Binding GroupingParameter}" Width="280" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Discord processes">
                <DataGrid x:Name="dgProcesses" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="#211D26" Foreground="White"
                          RowBackground="#211D26" AlternatingRowBackground="#2A2430" BorderThickness="0"
                          CellStyle="{StaticResource CopyableCell}"
                          ColumnHeaderStyle="{StaticResource ReadableColumnHeader}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                        <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="150" />
                        <DataGridTextColumn Header="Inferred role" Binding="{Binding Role}" Width="220" />
                        <DataGridTextColumn Header="Window title" Binding="{Binding WindowTitle}" Width="260" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="130" />
                        <DataGridTextColumn Header="Started" Binding="{Binding StartTime}" Width="170" />
                        <DataGridTextColumn Header="Command line" Binding="{Binding CommandLine}" Width="420">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource CopyableCell}">
                                    <Setter Property="ToolTip" Value="{Binding CommandLine}" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Executable path" Binding="{Binding ExecutablePath}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="12,0,12,10" Foreground="#B7AEBF" FontSize="11"
                   Text="Peak is the session-level audio meter. If Discord combines voice and UI audio in one session, the meter shows their combined level." />
    </Grid>
</Window>
