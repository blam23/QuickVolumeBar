<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QuickVolumeBar - Controller"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" SizeToContent="WidthAndHeight" Margin="0" Padding="0"
        Background="#F2181420" SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <Style x:Key="purpStylee">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Purple" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Black" />
            </Style.Resources>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Style="{StaticResource purpStylee}" Background="#F2181420">
        <ListView x:Name="lvApplications" Background="Transparent" SnapsToDevicePixels="True" MinWidth="800" KeyDown="AppsKeyDown" Margin="0" Padding="0" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Stretch">
                            <ProgressBar Foreground="DarkOrchid" Opacity="0.5" Background="Transparent" BorderThickness="0" Value="{Binding Volume}" ></ProgressBar>
                            <DockPanel Margin="10">
                                <Image Source="{Binding Icon}" Width="42" Height="42" DockPanel.Dock="Left" Margin="2"/>
                                <WrapPanel DockPanel.Dock="Left" Margin="2" Orientation="Vertical">
                                    <WrapPanel DockPanel.Dock="Left" Margin="2" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="White" Margin="10,0" FontSize="20"/>
                                        <TextBlock Text="{Binding Title}" MaxWidth="500" VerticalAlignment="Center" Foreground="White" Margin="10,7" FontSize="16"/>
                                    </WrapPanel>
                                </WrapPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Volume, StringFormat={}{0:0.}%}" Foreground="White" FontSize="32" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.8"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Window>
